# ==============================================================
# PHONE TRADING HUB - ENVIRONMENT CONFIGURATION (VPS PRODUCTION)
# ==============================================================

# Server Environment
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# SQLite Database Paths
# In a VPS with a dedicated mount point, set to /data or /data/accounting.db
DB_DIR=/data
DB_PATH=/data/accounting.db

# Production Authentication & Initial Administrator Account
# Initial admin is created automatically only on first setup if no admin exists
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin1234!
SESSION_TTL_HOURS=24

# Backup Retention (Number of historical backups to retain)
MAX_BACKUP_RETENTION=30
