# ==============================================================
# PHONE TRADING HUB - ENVIRONMENT CONFIGURATION (VPS PRODUCTION)
# ==============================================================

# Server Environment
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# SQLite Database Paths
# In a VPS with a dedicated mount point, set to /data or /data/accounting.db
DB_DIR=/data
DB_PATH=/data/accounting.db

# Authentication Security Secrets
ADMIN_PIN=9999
SESSION_SECRET=change-this-to-a-secure-random-string-in-production

# Backup Retention (Number of historical backups to retain)
MAX_BACKUP_RETENTION=30
